        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if it arrives damaged or not as described?",
            "icon": "none",
            "row_content": "<p>Email us within 7 days of delivery with a photo and we will replace it or refund you in full, your choice. Defects within 6 months are covered under Singapore's Lemon Law.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I return it if I change my mind?",
            "icon": "none",
            "row_content": "<p>Yes, unused and in original packaging, within 14 days of delivery. You cover return postage; we refund the item price.</p>"
          }
        }
